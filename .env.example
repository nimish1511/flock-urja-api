# Urja Meter Ops Upstream Configuration
PORTAL_BASE_URL=https://urja-ops.flockenergy.tech
PORTAL_USERNAME=operator@urja.local
PORTAL_PASSWORD=your_password_here

# Service Settings
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Cache & Sync Settings
CACHE_TTL_SECONDS=900
AUTO_SYNC_ON_STARTUP=true

# Request Settings
UPSTREAM_TIMEOUT_SECONDS=15.0
UPSTREAM_MAX_RETRIES=3
